<script>
  // Reveal sections as they scroll in, and fill the barometer once it is visible.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = document.querySelectorAll<HTMLElement>('.kili .rv');
  if (reduce || !('IntersectionObserver' in window)) {
    els.forEach(e => e.classList.add('in'));
  } else {
    document.documentElement.classList.add('rv-on');
    const io = new IntersectionObserver(entries => {
      entries.forEach(en => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
    }, { rootMargin: '0px 0px -10% 0px' });
    els.forEach(e => io.observe(e));
  }
  const meter = document.querySelector<HTMLElement>('.meter');
  const fill = meter?.querySelector<SVGRectElement>('.fill');
  if (meter && fill && !reduce && 'IntersectionObserver' in window) {
    const level = Number(meter.dataset.level);
    fill.setAttribute('y', '300'); fill.setAttribute('height', '0');
    const mo = new IntersectionObserver(([en]) => {
      if (!en.isIntersecting) return;
      mo.disconnect();
      const t0 = performance.now(), dur = 1800;
      const step = (now: number) => {
        const k = Math.min(1, (now - t0) / dur), e = 1 - Math.pow(1 - k, 3), y = 300 - e * (300 - level);
        fill.setAttribute('y', String(y)); fill.setAttribute('height', String(300 - y));
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }, { threshold: 0.5 });
    mo.observe(meter);
  }
  // Countdown to the start, refreshed in the browser so it never goes stale.
  const cnt = document.querySelector<HTMLElement>('.count');
  if (cnt) {
    const left = Math.ceil((Date.parse(cnt.dataset.start!) - Date.now()) / 86400000);
    cnt.querySelector('b')!.textContent = left > 0 ? String(left) : '✓';
    cnt.querySelector('span')!.textContent = left <= 0 ? cnt.dataset.started! : left === 1 ? cnt.dataset.one! : cnt.dataset.many!;
  }

  // Scroll altimeter: 0 m at the top of the page, the summit at the bottom.
  const alti = document.querySelector<HTMLElement>('.alti');
  if (alti) {
    const top = Number(alti.dataset.top), out = alti.querySelector('b')!, lang = document.documentElement.lang;
    const fmt = (n: number) => lang === 'de' ? n.toLocaleString('de-CH').replace(/’/g, "'") : n.toLocaleString(lang === 'hu' ? 'hu-HU' : 'en-GB');
    let ticking = false;
    const update = () => {
      ticking = false;
      const max = document.documentElement.scrollHeight - innerHeight;
      const k = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
      alti.classList.toggle('show', scrollY > innerHeight * 0.5);
      alti.classList.toggle('peak', k > 0.985);
      out.textContent = k > 0.985 ? `${fmt(top)} m · ${alti.dataset.summit}` : `${fmt(Math.round(k * top / 10) * 10)} m`;
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }

  // Donate bar: shown after the hero, hidden while the hero or the closing section is on screen.
  const bar = document.querySelector<HTMLElement>('.give-bar');
  const kili = document.querySelector<HTMLElement>('.kili');
  if (bar && kili && 'IntersectionObserver' in window) {
    const days = bar.querySelector<HTMLElement>('.bar-days')!;
    const left = Math.max(0, Math.ceil((Date.parse(days.dataset.start!) - Date.now()) / 86400000));
    days.textContent = days.textContent!.replace(/^\d+/, String(left));
    const seen = new Set<Element>();
    const bo = new IntersectionObserver(entries => {
      entries.forEach(en => en.isIntersecting ? seen.add(en.target) : seen.delete(en.target));
      kili.classList.toggle('bar-on', seen.size === 0);
    });
    document.querySelectorAll('.hero, .end').forEach(s => bo.observe(s));
  }

  // Amount window: every donate button opens it; "continue" goes to the Muskathlon page, which sends the form on to checkout.
  const gd = document.querySelector<HTMLDialogElement>('dialog.give');
  const gdata = document.getElementById('give-data');
  if (gd && gdata && typeof gd.showModal === 'function') {
    const cfg = JSON.parse(gdata.textContent!) as { base: string; def: number; hu: boolean; rate: number; g: Record<string, string> };
    const chips = gd.querySelectorAll<HTMLButtonElement>('.chip');
    const own = gd.querySelector<HTMLInputElement>('.own input')!;
    const go = gd.querySelector<HTMLAnchorElement>('.go')!;
    const impact = gd.querySelector<HTMLElement>('.impact')!;
    const chf = (a: number) => cfg.hu ? `${a} CHF` : `CHF ${a}`;
    const ft = (a: number) => (Math.round(a * cfg.rate / 1000) * 1000).toLocaleString('hu-HU');
    const set = (a: number, typed = false) => {
      chips.forEach(c => c.setAttribute('aria-checked', String(Number(c.dataset.a) === a)));
      if (!typed) own.value = [...chips].some(c => Number(c.dataset.a) === a) ? '' : String(a);
      const ok = Number.isInteger(a) && a >= 5 && a <= 99999;
      go.classList.toggle('off', !ok);
      go.setAttribute('aria-disabled', String(!ok));
      go.href = ok ? `${cfg.base}?amount=${a}` : '#';
      go.dataset.track = ok ? `go-${a}` : 'none';
      go.textContent = ok ? `${cfg.g.go} · ${chf(a)} ↗` : cfg.g.min;
      const m = Math.floor(a / 62);
      let t = a >= 1200 ? cfg.g.full : m >= 1 ? cfg.g.line.replace('{m}', m === 1 ? cfg.g.one : cfg.g.many.replace('{n}', String(m))) : cfg.g.low;
      if (cfg.hu && ok) t = `${chf(a)} ≈ ${ft(a)} Ft. ${t}`;
      impact.textContent = t;
    };
    chips.forEach(c => c.addEventListener('click', () => set(Number(c.dataset.a))));
    own.addEventListener('input', () => set(Math.round(Number(own.value)), true));
    own.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); go.click(); } });
    go.addEventListener('click', e => { if (go.classList.contains('off')) { e.preventDefault(); return; } setTimeout(() => gd.close(), 300); });
    gd.addEventListener('click', e => { if (e.target === gd) gd.close(); });
    document.querySelectorAll<HTMLAnchorElement>('a[data-track^="donate-"]').forEach(a => a.addEventListener('click', e => {
      e.preventDefault();
      set(Number(new URL(a.href).searchParams.get('amount')) || cfg.def);
      gd.showModal();
    }));
  }

  // Easter egg: three taps on the summit plant the flag.
  const hit = document.querySelector<SVGCircleElement>('.eg-hit');
  const fig = document.querySelector<HTMLElement>('.meter');
  if (hit && fig) {
    let taps = 0, timer = 0;
    const plant = () => {
      if (fig.classList.contains('planted')) return;
      fig.classList.add('planted');
      const msg = fig.querySelector<HTMLElement>('.eg-msg')!; msg.textContent = msg.dataset.msg!;
      if (reduce) return;
      const colors = ['#ffd06b', '#e58a2e', '#f2efe9', '#c8102e', '#00843d'];
      for (let i = 0; i < 40; i++) {
        const c = document.createElement('i');
        c.className = 'confetti';
        c.style.left = `${53 + (Math.random() * 12 - 6)}%`;
        c.style.setProperty('--x', `${Math.random() * 260 - 130}px`);
        c.style.setProperty('--y', `${-80 - Math.random() * 140}px`);
        c.style.setProperty('--r', `${Math.random() * 720 - 360}deg`);
        c.style.background = colors[i % colors.length];
        c.style.animationDelay = `${Math.random() * 120}ms`;
        fig.appendChild(c);
        setTimeout(() => c.remove(), 1800);
      }
    };
    const tap = () => { taps++; clearTimeout(timer); timer = window.setTimeout(() => { taps = 0; }, 900); if (taps >= 3) { taps = 0; plant(); } };
    hit.addEventListener('click', tap);
    hit.addEventListener('keydown', e => { if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') { e.preventDefault(); tap(); } });
  }

  // Media gallery: carousel, lightbox and sharing (the video file itself where the phone allows it).
  const md = document.getElementById('media-data');
  if (md) {
    type Item = { type: 'video' | 'image'; src: string; poster?: string; when: string; title: string };
    const { items, t } = JSON.parse(md.textContent!) as { items: Item[]; t: Record<string, string> };
    const track = document.querySelector<HTMLElement>('.carousel')!;
    const dlg = document.querySelector<HTMLDialogElement>('.lightbox')!;
    const box = dlg.querySelector<HTMLElement>('.lb-media')!;
    const toast = document.querySelector<HTMLElement>('.toast')!;
    const pageUrl = location.origin + location.pathname;
    const files = new Map<string, File>();
    let current: Item = items[0];
    const home = toast.parentElement!;
    // while the lightbox is open the toast must live inside it, or the dialog covers it
    const say = (msg: string) => { (dlg.open ? dlg : home).appendChild(toast); toast.textContent = msg; toast.classList.add('on'); setTimeout(() => toast.classList.remove('on'), 2200); };
    const prefetch = (it: Item) => {
      if (it.type !== 'video' || files.has(it.src) || !('canShare' in navigator)) return;
      fetch(it.src).then(r => r.blob()).then(b => {
        const f = new File([b], it.src.split('/').pop()!, { type: 'video/mp4' });
        if (navigator.canShare({ files: [f] })) files.set(it.src, f);
      }).catch(() => {});
    };
    const copy = async () => {
      try { await navigator.clipboard.writeText(pageUrl); }
      catch {
        const ta = document.createElement('textarea'); ta.value = pageUrl; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select(); try { document.execCommand('copy'); } catch {} ta.remove();
      }
      say(t.copied);
    };
    // A small share menu for desktops (and phones without a share sheet).
    const enc = encodeURIComponent;
    const menuFor = (host: HTMLElement) => {
      let m = host.querySelector<HTMLElement>('.share-menu');
      if (m) return m;
      m = document.createElement('div');
      m.className = 'share-menu'; m.hidden = true;
      const links: [string, string][] = [
        ['WhatsApp', `https://wa.me/?text=${enc(`${t.text} ${pageUrl}`)}`],
        [t.email, `mailto:?subject=${enc(t.title)}&body=${enc(`${t.text} ${pageUrl}`)}`],
        ['Facebook', `https://www.facebook.com/sharer/sharer.php?u=${enc(pageUrl)}`],
        ['LinkedIn', `https://www.linkedin.com/sharing/share-offsite/?url=${enc(pageUrl)}`],
        ['X', `https://twitter.com/intent/tweet?text=${enc(t.text)}&url=${enc(pageUrl)}`],
      ];
      const b = document.createElement('button'); b.type = 'button'; b.textContent = t.copyLink; b.addEventListener('click', copy);
      m.appendChild(b);
      links.forEach(([label, href]) => { const a = document.createElement('a'); a.href = href; a.textContent = label; a.target = '_blank'; a.rel = 'noopener'; m!.appendChild(a); });
      host.appendChild(m);
      return m;
    };
    const touch = matchMedia('(pointer: coarse)').matches;
    const share = async (it: Item | null, host: HTMLElement) => {
      if (touch && navigator.share) {
        try {
          const f = it ? files.get(it.src) : undefined;
          if (f) await navigator.share({ files: [f], title: t.title, text: `${t.text} ${pageUrl}` });
          else await navigator.share({ title: t.title, text: t.text, url: pageUrl });
          return;
        } catch (e) { if ((e as Error).name === 'AbortError') return; }
      }
      const m = menuFor(host);
      const wasHidden = m.hidden;
      document.querySelectorAll<HTMLElement>('.share-menu').forEach(x => { x.hidden = true; });
      m.hidden = !wasHidden;
      if (!m.hidden) copy();
    };
    document.addEventListener('click', e => {
      const el = e.target as HTMLElement;
      if (!el.closest('.share-menu') && !el.closest('.share-main') && !el.closest('.lb-share')) document.querySelectorAll<HTMLElement>('.share-menu').forEach(x => { x.hidden = true; });
    });
    const open = (i: number) => {
      current = items[i];
      box.innerHTML = '';
      if (current.type === 'video') {
        const v = document.createElement('video');
        v.src = current.src; v.controls = true; v.playsInline = true; v.autoplay = true; if (current.poster) v.poster = current.poster;
        box.appendChild(v); prefetch(current);
      } else {
        const img = document.createElement('img'); img.src = current.src; img.alt = current.title; box.appendChild(img);
      }
      dlg.querySelector('.lb-title')!.textContent = current.title;
      dlg.querySelector<HTMLAnchorElement>('.lb-dl')!.href = current.src;
      dlg.showModal();
    };
    const closeDlg = () => { box.querySelector('video')?.pause(); dlg.querySelector<HTMLElement>('.share-menu')?.setAttribute('hidden', ''); dlg.close(); };
    track.querySelectorAll<HTMLButtonElement>('.mcard').forEach(b => b.addEventListener('click', () => open(Number(b.dataset.i))));
    dlg.querySelector('.lb-close')!.addEventListener('click', closeDlg);
    dlg.querySelector('.lb-x')!.addEventListener('click', closeDlg);
    dlg.addEventListener('click', e => { if (e.target === dlg) closeDlg(); });
    dlg.addEventListener('close', () => box.querySelector('video')?.pause());
    dlg.querySelector('.lb-share')!.addEventListener('click', () => share(current, dlg.querySelector<HTMLElement>('.lb-bar')!));
    document.querySelector('.share-main')!.addEventListener('click', () => share(items.find(x => x.type === 'video') ?? null, document.querySelector<HTMLElement>('.share-row')!));
    document.querySelectorAll<HTMLButtonElement>('.arr').forEach(b => b.addEventListener('click', () => {
      const card = track.querySelector('li');
      track.scrollBy({ left: Number(b.dataset.dir) * ((card?.clientWidth ?? 300) + 16), behavior: reduce ? 'auto' : 'smooth' });
    }));
  }

  document.querySelectorAll<HTMLAnchorElement>('.d-lang a').forEach(a =>
    a.addEventListener('click', () => { try { localStorage.setItem('gl-lang', a.lang); } catch {} }));
</script>

