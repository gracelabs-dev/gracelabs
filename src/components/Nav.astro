---
import { SITE, LANGS, t as tr, type Lang } from '../data/site';
interface Props { lang: Lang; path?: string }
const { lang, path = '' } = Astro.props;
const t = tr(lang);
const home = `/${lang}/`;
---
<a class="skip" href="#main">{{ en: 'Skip to content', de: 'Zum Inhalt springen', hu: 'Ugrás a tartalomra' }[lang]}</a>
<nav class="d-nav">
  <a class="brand" href={home}><svg class="mark" viewBox="9.5 9.5 46 46" width="32" height="32" aria-hidden="true"><circle cx="16" cy="16" r="6" fill="#ffd06b"/><path fill="none" stroke="#ffd06b" stroke-linecap="round" stroke-width="5" d="M31 16A15 15 0 0 1 16 31M42 16A26 26 0 0 1 36.84 31.55M31.55 36.84A26 26 0 0 1 16 42M53 16A37 37 0 0 1 50.24 30.01M46.72 36.62A37 37 0 0 1 36.62 46.72M30.01 50.24A37 37 0 0 1 16 53"/></svg><b>{SITE.brand}</b></a>
  <div>
    <a class="lk" href={`${home}#svc`}>{t.navSvc}</a>
    <a class="lk" href={`${home}#pricing`}>{t.navPrice}</a>
    <a class="lk" href={`${home}#work`}>{t.navWork}</a>
    <a class="lk" href={`${home}#about`}>{t.navAbout}</a>
    <a class="cta" href={`${home}#contact`}>{t.navCta}</a>
    <span class="d-lang">
      {LANGS.map(l => <a href={`/${l}/${path}`} data-lang={l} hreflang={l} lang={l} class={l === lang ? 'on' : undefined}>{l.toUpperCase()}</a>)}
    </span>
  </div>
</nav>
